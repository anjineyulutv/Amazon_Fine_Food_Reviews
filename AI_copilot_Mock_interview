        "COURSE_KNOWLEDGE = [\n",
        "    \"Customer Acquisition Cost (CAC) vs Lifetime Value (LTV)\",\n",
        "    \"Marketing funnel optimization\",\n",
        "    \"Multi-touch attribution modeling\",\n",
