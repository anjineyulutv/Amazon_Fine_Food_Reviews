        "            np.mean([float(n) for n in nums[:3]]), 1\n",
        "        )\n",
        "        return score, result\n",
        "    except Exception as e:\n",
        "        raise RuntimeError(\n",
        "            f\"Could not parse evaluation response: {result[:150]}. Error: {e}\"\n",
        "        )\n",
        "\n",
