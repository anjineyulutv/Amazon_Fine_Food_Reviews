        "def transcribe(audio_path):\n",
        "    if audio_path is None:\n",
        "        raise RuntimeError(\"No audio file received — recording may have failed.\")\n",
        "    try:\n",
        "        wav_path = f\"/tmp/{uuid.uuid4()}.wav\"\n",
        "\n",
        "        # Minimal processing — just convert and normalize, no aggressive filtering\n",
        "        subprocess.run([\n",
        "            \"ffmpeg\", \"-y\", \"-i\", audio_path,\n",
        "            \"-ar\", \"16000\", \"-ac\", \"1\",\n",
        "            \"-af\", \"volume=2.0\",\n",
        "            \"-f\", \"wav\", wav_path\n",
        "        ], capture_output=True)\n",
        "\n",
        "        # Check file has content\n",
        "        if not os.path.exists(wav_path) or os.path.getsize(wav_path) < 1000:\n",
        "            raise RuntimeError(\"FFmpeg conversion produced empty file.\")\n",
        "\n",
        "        with open(wav_path, \"rb\") as f:\n",
        "            audio_bytes = f.read()\n",
        "\n",
        "        audio  = speech.RecognitionAudio(content=audio_bytes)\n",
        "        config = speech.RecognitionConfig(\n",
        "            encoding=speech.RecognitionConfig.AudioEncoding.LINEAR16,\n",
        "            sample_rate_hertz=16000,\n",
        "            language_code=\"en-US\",\n",
        "            enable_automatic_punctuation=True,\n",
        "            use_enhanced=True,\n",
        "            model=\"latest_long\",   # better than \"video\" for conversational speech\n",
        "            speech_contexts=[speech.SpeechContext(\n",
        "                phrases=[\n",
        "                    \"CAC\", \"LTV\", \"ROAS\", \"attribution\", \"funnel\",\n",
        "                    \"cohort\", \"churn\", \"MQL\", \"SQL\", \"NPS\", \"A/B test\",\n",
        "                    \"GTM\", \"ICP\", \"PMF\", \"DAU\", \"MAU\", \"CPM\", \"CPC\",\n",
        "                    \"conversion rate\", \"retention\", \"activation\",\n",
        "                    \"payback period\", \"marketing mix\", \"brand equity\",\n",
        "                    \"share of voice\", \"north star metric\",\n",
        "                ],\n",
        "                boost=10.0\n",
        "            )]\n",
        "        )\n",
        "\n",
        "        response = speech_client.recognize(config=config, audio=audio)\n",
        "\n",
        "        if not response.results:\n",
        "            # Try again without enhanced model as fallback\n",
        "            config2 = speech.RecognitionConfig(\n",
        "                encoding=speech.RecognitionConfig.AudioEncoding.LINEAR16,\n",
        "                sample_rate_hertz=16000,\n",
        "                language_code=\"en-US\",\n",
        "                enable_automatic_punctuation=True,\n",
        "            )\n",
        "            response = speech_client.recognize(config=config2, audio=audio)\n",
        "\n",
        "        text = \" \".join([r.alternatives[0].transcript for r in response.results])\n",
        "\n",
        "        if not text.strip():\n",
        "            raise RuntimeError(\n",
        "                \"Speech not detected — please speak clearly and close to the mic.\")\n",
        "        return text\n",
        "\n",
        "    except RuntimeError:\n",
        "        raise\n",
        "    except Exception as e:\n",
        "        raise RuntimeError(f\"STT error: {str(e)[:120]}\")\n",
        "\n",
        "print(\"✅ transcribe() ready\")"
