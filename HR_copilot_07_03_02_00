        "        _r = gemini_with_timeout(\n",
        "            f\"Extract 1-2 key marketing interview topics from this text.\\n\"\n",
        "            f\"Return ONLY a Python list of short topic name strings. Example: [\\\"Topic A\\\", \\\"Topic B\\\"]\\n\\n\"\n",
        "            f\"{doc}\",\n",
